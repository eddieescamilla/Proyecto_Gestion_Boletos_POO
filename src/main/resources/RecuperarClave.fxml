<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controladores.RecuperarClaveController"
      prefWidth="800" prefHeight="568">

    <HBox styleClass="encabezado">
        <SVGPath content="M2,6 H22 V10 A2,2 0 0,0 22,14 V18 H2 V14 A2,2 0 0,0 2,10 Z"
                 fill="WHITE"/>
        <Label text="Gestión de Boletos" styleClass="encabezado-titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text=""/>
    </HBox>

    <VBox alignment="TOP_CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" bottom="24"/>
        </padding>

        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56"
                   style="-fx-background-color: #4F46E5; -fx-background-radius: 12;">
            <SVGPath content="M12,2 L2,7 L2,13 Q2,19 12,22 Q22,19 22,13 L22,7 Z"
                     fill="WHITE" scaleX="1.2" scaleY="1.2"/>
        </StackPane>

        <Label text="Recuperar clave" styleClass="titulo"/>
        <Label text="Ingresa tu correo y define una clave nueva" styleClass="subtitulo"/>

        <VBox styleClass="tarjeta" spacing="8" maxWidth="380">
            <Label text="Correo electrónico" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtCorreo" promptText="usuario@correo.com"/>

            <Label text="Nueva clave" styleClass="etiqueta-campo"/>
            <PasswordField fx:id="txtClaveNueva" promptText="Define una clave"/>

            <Label text="Confirmar clave" styleClass="etiqueta-campo"/>
            <PasswordField fx:id="txtClaveConfirmar" promptText="Repite la clave"/>

            <HBox spacing="8">
                <Button text="Volver" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#volver"/>
                <Button text="Restablecer" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#restablecer"/>
            </HBox>

            <Label text="Nota: por ahora el restablecimiento solo pide el correo registrado. Un flujo completo con verificación por correo/SMS está en el backlog."
                   styleClass="subtitulo" wrapText="true"/>
        </VBox>
    </VBox>
</VBox>
