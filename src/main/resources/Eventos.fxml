<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controladores.EventosController"
      prefWidth="800" prefHeight="568">

    <!-- Encabezado de la aplicacion -->
    <HBox styleClass="encabezado">
        <SVGPath content="M2,6 H22 V10 A2,2 0 0,0 22,14 V18 H2 V14 A2,2 0 0,0 2,10 Z"
                 fill="WHITE"/>
        <Label text="Gestión de Boletos" styleClass="encabezado-titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblUsuario" text="Bienvenido"/>
    </HBox>

    <!-- Contenido -->
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>

        <VBox spacing="4">
            <Label text="Eventos disponibles" styleClass="titulo"/>
            <Label text="Selecciona un evento de la tabla para continuar con tu compra"
                   styleClass="subtitulo"/>
        </VBox>

        <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No hay eventos para mostrar" styleClass="subtitulo"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="205"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="95"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colLugar" text="Lugar" prefWidth="170"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="95" styleClass="precio"/>
            </columns>
        </TableView>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Cerrar sesión" styleClass="boton-peligro" onAction="#cerrarSesion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Mi historial" styleClass="boton-secundario" onAction="#verHistorial"/>
            <Button text="Comprar" styleClass="boton-primario" onAction="#comprar"/>
        </HBox>
    </VBox>
</VBox>