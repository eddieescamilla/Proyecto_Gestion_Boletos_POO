# Plantilla de credenciales para el desarrollo local.
# Copia este archivo como `.env` (que está en .gitignore) y ajusta los
# valores. `ConfigBD` los lee al arrancar la aplicación.

BOLETOS_DB_URL=jdbc:postgresql://localhost:5432/boletos
BOLETOS_DB_USER=boletos
BOLETOS_DB_PASSWORD=cambiar-en-produccion
