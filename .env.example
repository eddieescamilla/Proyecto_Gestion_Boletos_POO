# Plantilla de credenciales para el desarrollo local.
# Copia este archivo como `.env` (que está en .gitignore) y ajusta los
# valores. `ConfigBD` los lee al arrancar la aplicación.

BOLETOS_DB_URL=jdbc:postgresql://localhost:5432/boletos
BOLETOS_DB_USER=boletos
BOLETOS_DB_PASSWORD=cambiar-en-produccion

# Clave del administrador por defecto. La app la hashea con BCrypt y la usa
# para sembrar la fila una sola vez; si una fila administradora ya existe no
# la toca. Dejala en blanco (o quita la linea) para que la app arranque sin
# sembrar un administrador por defecto (recomendado para produccion).
BOLETOS_ADMIN_PASSWORD=admin123
# Correo del administrador por defecto. Opcional, por defecto admin@boletos.com.
# BOLETOS_ADMIN_EMAIL=admin@boletos.com
